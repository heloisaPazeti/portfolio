---
import Base from '../../../../layouts/Base.astro';
import { languages, ui, url } from '../../../../i18n/utils';
import { programmingLanguages } from '../../../../data/programmingLanguages';
import { getProjects } from '../../../../lib/projects';

// One page per (site language × programming language): /pt/projects/cpp/, ...
export function getStaticPaths() {
  return languages.flatMap((lang) =>
    programmingLanguages.map((pl) => ({
      params: { lang, language: pl.slug },
      props: { lang, programmingLanguage: pl },
    })),
  );
}

const { lang, programmingLanguage } = Astro.props;
const t = ui[lang];

// Only projects of this programming language, in the current site language
const projects = (await getProjects(lang)).filter(
  (p) => p.entry.data.language === programmingLanguage.slug,
);
---
<Base
  lang={lang}
  title={`${programmingLanguage.name} — ${t.projects}`}
  backHref={url(`/${lang}/`)}
>
  <h1 class="sr-only">{programmingLanguage.name}</h1>

  {projects.length === 0 ? (
    <p class="empty">{t.noProjects}</p>
  ) : (
    <section class="stage" data-carousel aria-roledescription="carousel" aria-label={t.projects}>
      {projects.map(({ slug, entry }, i) => (
        <a
          class="slide"
          href={url(`/${lang}/projects/${programmingLanguage.slug}/${slug}/`)}
          data-slug={slug}
          data-dist={String(Math.min(i, 3))}
          aria-current={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          style={`--abs:${i}; --sign:${i > 0 ? 1 : 0}`}
        >
          <div class="cover">
            {entry.data.cover ? (
              <img src={url(entry.data.cover)} alt="" draggable="false" />
            ) : (
              <span aria-hidden="true">{entry.data.title.charAt(0)}</span>
            )}
          </div>
          <span class="name">{entry.data.title}</span>
        </a>
      ))}

      <button class="nav prev" type="button" aria-label={t.prev} disabled>
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor"
             stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 5l-7 7 7 7" />
        </svg>
      </button>
      <button class="nav next" type="button" aria-label={t.next} disabled={projects.length < 2}>
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor"
             stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </section>
  )}
</Base>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }
  .empty { min-height: 100svh; display: grid; place-content: center; margin: 0; opacity: .7; }

  .stage {
    --big: clamp(200px, 36vmin, 400px); /* size of the active square */
    --ratio: .55;                       /* size of the other squares relative to the active one */
    --gap: clamp(1rem, 3vw, 3rem);
    position: relative; height: 100svh; overflow: hidden;
    touch-action: pan-y; /* lets horizontal swipes reach our handlers */
  }

  .slide {
    position: absolute; left: 50%; top: 50%; width: var(--big);
    display: grid; gap: 1rem; justify-items: center; text-align: center;
    text-decoration: none; color: #fff; opacity: .5;

    /* Horizontal offset from the center, based on the distance to the active slide.
       --sign is -1 / 0 / 1 (left / active / right) and --abs is the distance. */
    --x: calc(
      var(--sign) * (
        var(--big) * .5 + var(--gap) + var(--big) * var(--ratio) * .5
        + (var(--abs) - 1) * (var(--big) * var(--ratio) + var(--gap))
      )
    );
    transform: translate(-50%, -50%) translateX(var(--x)) scale(var(--scale, var(--ratio)));
    transition: transform .6s cubic-bezier(.2, .7, .2, 1), opacity .4s;
  }
  .slide[aria-current='true'] { --scale: 1; opacity: 1; z-index: 2; }
  .slide[data-dist='2'] { opacity: .25; }
  .slide[data-dist='3'] { opacity: 0; pointer-events: none; }

  .cover {
    width: 100%; aspect-ratio: 1; overflow: hidden; border-radius: 4px;
    background: #d9d9d9; color: #111; display: grid; place-items: center;
    font-size: 4rem; font-weight: 600;
    transition: box-shadow .6s;
  }
  .slide[aria-current='true'] .cover { box-shadow: 0 0 80px rgb(255 255 255 / .18); }
  .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .name { font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 500; }

  .nav {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 3;
    background: none; border: 0; color: #fff; cursor: pointer; padding: .75rem;
    opacity: .7; transition: opacity .2s, filter .2s;
  }
  .nav:hover:not(:disabled), .nav:focus-visible { opacity: 1; filter: drop-shadow(0 0 8px rgb(255 255 255 / .7)); }
  .nav:disabled { opacity: 0; pointer-events: none; }
  .prev { left: clamp(.25rem, 2vw, 1.5rem); }
  .next { right: clamp(.25rem, 2vw, 1.5rem); }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-carousel]');

  if (stage) {
    const slides = Array.from(stage.querySelectorAll<HTMLAnchorElement>('.slide'));
    const prev = stage.querySelector<HTMLButtonElement>('.prev')!;
    const next = stage.querySelector<HTMLButtonElement>('.next')!;

    // The "Back" link from a project page returns with #project-slug in the URL
    let active = Math.max(0, slides.findIndex((s) => s.dataset.slug === location.hash.slice(1)));
    let suppressClick = false;

    function render() {
      slides.forEach((slide, i) => {
        const d = i - active;
        slide.style.setProperty('--abs', String(Math.abs(d)));
        slide.style.setProperty('--sign', String(Math.sign(d)));
        slide.dataset.dist = String(Math.min(Math.abs(d), 3));
        slide.setAttribute('aria-current', String(i === active));
        slide.tabIndex = i === active ? 0 : -1;
      });
      prev.disabled = active === 0;
      next.disabled = active === slides.length - 1;
    }

    function go(index: number) {
      const target = Math.min(Math.max(index, 0), slides.length - 1);
      if (target === active) return;
      active = target;
      render();
      slides[active].focus({ preventScroll: true });
      // Remember the position, so the browser's back button returns to it
      history.replaceState(null, '', `#${slides[active].dataset.slug}`);
    }

    render();

    prev.addEventListener('click', () => go(active - 1));
    next.addEventListener('click', () => go(active + 1));

    // Clicking a side slide brings it to the center; clicking the active one opens it
    slides.forEach((slide, i) => {
      slide.addEventListener('click', (e) => {
        if (suppressClick) { e.preventDefault(); return; }
        if (i !== active) { e.preventDefault(); go(i); }
      });
    });

    // Keyboard: ← → to move, Home / End for the ends, Enter to open
    document.addEventListener('keydown', (e) => {
      const el = e.target as HTMLElement;
      // Ignore keys while the language switcher, back link, etc. are focused
      if (el !== document.body && !el.classList.contains('slide')) return;

      if (e.key === 'ArrowRight') go(active + 1);
      else if (e.key === 'ArrowLeft') go(active - 1);
      else if (e.key === 'Home') go(0);
      else if (e.key === 'End') go(slides.length - 1);
      else if (e.key === 'Enter') { e.preventDefault(); slides[active].click(); }
    });

    // Touch / mouse swipe
    let startX = 0;
    stage.addEventListener('pointerdown', (e) => { startX = e.clientX; });
    stage.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (Math.abs(dx) < 50) return;
      go(active + (dx < 0 ? 1 : -1));
      suppressClick = true; // a swipe must not count as a click
      setTimeout(() => { suppressClick = false; }, 0);
    });
  }
</script>
