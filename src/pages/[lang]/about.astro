---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { languages, url } from '../../i18n/utils';
import { links } from '../../data/links';

// One page per site language: /pt/about/, /fr/about/, /en/about/
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const entry = await getEntry('about', lang); // file src/content/about/<lang>.md
if (!entry) throw new Error(`Missing file: src/content/about/${lang}.md`);
const { Content } = await render(entry);
---
<Base
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  backHref={url(`/${lang}/`)}
>
  <article class="about">
    <h1>{entry.data.title}</h1>
    <div class="body"><Content /></div>

    <ul class="links">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </article>
</Base>

<style>
  .about {
    max-width: 680px; margin: 0 auto; padding: 7rem 1.5rem 4rem;
    animation: enter .8s cubic-bezier(.2, .7, .2, 1) both;
  }
  h1 { font-size: clamp(2.2rem, 6vw, 3.5rem); font-weight: 500; margin: 0 0 2rem; }
  .body { font-size: 1.15rem; line-height: 1.75; }
  .body :global(p) { margin: 0 0 1.25rem; }
  .body :global(a) { text-decoration: none; border-bottom: 1px solid #fff; }

  .links { list-style: none; padding: 0; margin: 3rem 0 0; display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .links a {
    text-decoration: none; opacity: .7; letter-spacing: .05em;
    transition: opacity .2s, text-shadow .2s;
  }
  .links a:hover, .links a:focus-visible { opacity: 1; text-shadow: 0 0 14px rgb(255 255 255 / .7); }

  @keyframes enter { from { opacity: 0; transform: translateY(12px); } }
</style>
