---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <title>Portfolio</title>
    <noscript><meta http-equiv="refresh" content={`0; url=${base}/pt/`} /></noscript>
    <script define:vars={{ base }}>
      // Pick the visitor's browser language; fall back to English
      const code = (navigator.language || 'pt').slice(0, 2);
      const target = ['pt', 'fr', 'en'].includes(code) ? code : 'en';
      location.replace(`${base}/${target}/`);
    </script>
  </head>
  <body></body>
</html>
